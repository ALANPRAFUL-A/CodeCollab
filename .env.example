# =============================================================================
# CodeCollab - environment template
# =============================================================================
# Copy this file to `.env` in the SAME directory as docker-compose.yml:
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# Then replace every CHANGE_ME. Compose reads .env automatically and will refuse
# to start if a required value is missing (that is the `${VAR:?...}` syntax).
#
# `.env` is already covered by .gitignore. Never commit it.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED SECRETS
# -----------------------------------------------------------------------------

# Signs the JWTs issued by /api/auth/login and /api/auth/register.
#
# All three backend replicas MUST share this value. A token minted by backend-1
# is verified by whichever replica the load balancer picks next, so a mismatch
# would log users out at random.
#
# Note the app falls back to the literal string "fallback_secret" if this is
# unset, which means auth would appear to work while being trivially forgeable.
# Generate a real one:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   bash:       openssl rand -base64 48
JWT_SECRET=CHANGE_ME_use_a_long_random_string

# MongoDB root credentials. Consumed twice: once by the mongo container to create
# the user on first boot, and once to build MONGO_URI for the backends.
#
# IMPORTANT: these are only applied when the mongo-data volume is created. If you
# change them later you must also remove the volume:
#   docker compose down -v
MONGO_USER=codecollab
MONGO_PASSWORD=CHANGE_ME_mongo_password
MONGO_DB=codecollab

# Redis password. Redis lives on the internal network, so this is defence in
# depth rather than the primary control - but an unauthenticated Redis is a
# classic way to get owned, so set it anyway.
REDIS_PASSWORD=CHANGE_ME_redis_password

# Basic-auth for the HAProxy stats dashboard at http://localhost:8404
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=CHANGE_ME_stats_password


# -----------------------------------------------------------------------------
# PORTS (host side)
# -----------------------------------------------------------------------------

# The single public entry point. This is the URL you open in the browser.
PUBLIC_PORT=8080

# HAProxy live stats / server states.
HAPROXY_STATS_PORT=8404

# Squid. Bound to 127.0.0.1 in docker-compose.yml so it is never an open relay.
SQUID_PORT=3128


# -----------------------------------------------------------------------------
# APPLICATION CONFIG
# -----------------------------------------------------------------------------

# Origins allowed to call the API cross-origin. Must match the address you type
# in the browser. If you change PUBLIC_PORT, change this too.
# Multiple values are comma separated:
#   CORS_ORIGINS=http://localhost:8080,http://192.168.1.50:8080
CORS_ORIGINS=http://localhost:8080

# Where the FRONTEND sends its API and Socket.IO traffic.
#
# LEAVE THIS EMPTY. Empty means "same origin", so the browser sends everything to
# whatever host served the page, which is the reverse proxy. That is what makes
# the sticky-session cookie work and removes CORS entirely.
#
# Only set it for a split-origin deployment (e.g. SPA on Vercel, API on Render):
#   VITE_API_URL=https://api.example.com
#
# This is baked in at BUILD time, so changing it requires:
#   docker compose build frontend
VITE_API_URL=

# Enables GET /api/egress-test, which proves the forward proxy is working.
# Turn it off once you have finished verifying the stack.
ENABLE_EGRESS_TEST=true
